<Window x:Class="MetaGrid.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="MetaGrid"
        Icon="Assets/metagrid.ico"
        Width="1240"
        Height="800"
        MinWidth="1080"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        WindowState="Normal"
        ShowInTaskbar="True"
        Visibility="Visible"
        Opacity="1"
        Background="{StaticResource WindowBrush}"
        WindowStyle="SingleBorderWindow">
  <Grid Margin="20">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="264" />
      <ColumnDefinition Width="24" />
      <ColumnDefinition Width="*" />
    </Grid.ColumnDefinitions>

    <Border Grid.Column="0" Style="{StaticResource PanelBorderStyle}" Padding="18">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto" />
          <RowDefinition Height="12" />
          <RowDefinition Height="Auto" />
          <RowDefinition Height="*" />
          <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="MetaGrid" Style="{StaticResource PageTitleTextStyle}" FontSize="28" TextAlignment="Center" />
          <TextBlock Text="{Binding Text.AppSubtitle}"
                     Margin="0,6,0,0"
                     Foreground="{StaticResource SecondaryBrush}"
                     TextAlignment="Center"
                     HorizontalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Row="2"
                    Width="192"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0">
          <Button Style="{StaticResource SidebarButtonStyle}" Click="DashboardClick" Content="{Binding Text.Dashboard}" />
          <Button Style="{StaticResource SidebarButtonStyle}" Click="HeroGridClick" Content="{Binding Text.HeroGrid}" />
          <Button Style="{StaticResource SidebarButtonStyle}" Click="AccountsClick" Content="{Binding Text.Accounts}" />
          <Button Style="{StaticResource SidebarButtonStyle}" Click="HistoryClick" Content="{Binding Text.UpdateHistory}" />
          <Button Style="{StaticResource SidebarButtonStyle}" Click="SettingsClick" Content="{Binding Text.Settings}" />
          <Button Style="{StaticResource SidebarButtonStyle}" Click="AboutClick" Content="{Binding Text.About}" />
        </StackPanel>

        <StackPanel Grid.Row="4" HorizontalAlignment="Center">
          <Border Style="{StaticResource CardBorderStyle}" Padding="14" Width="188">
            <StackPanel>
              <TextBlock Text="{Binding ProviderCardTitle}"
                         Style="{StaticResource FieldLabelTextStyle}"
                         HorizontalAlignment="Center"
                         TextAlignment="Center" />
              <StackPanel Orientation="Horizontal"
                          Margin="0,10,0,0"
                          HorizontalAlignment="Center">
                <Ellipse Width="8" Height="8" Margin="0,4,8,0">
                  <Ellipse.Fill>
                    <Binding Path="ProviderIndicatorBrush" />
                  </Ellipse.Fill>
                </Ellipse>
                <TextBlock Text="{Binding ProviderStatusText}"
                           Foreground="{StaticResource PrimaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center" />
              </StackPanel>
            </StackPanel>
          </Border>
          <TextBlock Text="{Binding Text.MadeBy}"
                     Margin="0,10,0,0"
                     Foreground="{StaticResource MutedBrush}"
                     FontSize="11"
                     HorizontalAlignment="Center"
                     TextAlignment="Center" />
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>

      <Border Style="{StaticResource PanelBorderStyle}" Padding="22,20,22,18">
        <Grid>
          <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="16" />
            <RowDefinition Height="Auto" />
          </Grid.RowDefinitions>

          <StackPanel>
            <TextBlock Text="{Binding StatusTitle}" Style="{StaticResource PageTitleTextStyle}" />
            <TextBlock Text="{Binding StatusText}"
                       Margin="0,6,0,0"
                       Foreground="{StaticResource SecondaryBrush}"
                       TextWrapping="Wrap" />
            <WrapPanel Margin="0,14,0,0">
              <Border Style="{StaticResource StatusChipBorderStyle}"
                      Background="{Binding StatusChipBackgroundBrush}"
                      BorderBrush="{Binding StatusChipBorderBrush}">
                <TextBlock Text="{Binding StatusChipText}" Style="{StaticResource StatusChipTextStyle}" />
              </Border>
              <Border Style="{StaticResource StatusChipSuccessBorderStyle}">
                <TextBlock Text="{Binding AutoUpdateChipText}" Style="{StaticResource StatusChipTextStyle}" />
              </Border>
              <Border Style="{StaticResource StatusChipBorderStyle}"
                      Background="{Binding ProviderStatusChipBackgroundBrush}"
                      BorderBrush="{Binding ProviderStatusChipBorderBrush}">
                <TextBlock Text="{Binding ProviderStatusChipText}" Style="{StaticResource StatusChipTextStyle}" />
              </Border>
            </WrapPanel>
          </StackPanel>

          <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <WrapPanel Grid.Column="0" HorizontalAlignment="Left">
              <Button Content="{Binding InstallActionText}"
                      Style="{StaticResource PrimaryButtonStyle}"
                      Click="InstallGridClick"
                      Margin="0,0,12,8"
                      Visibility="{Binding CanOfferInstallAction, Converter={StaticResource BoolToVisibilityConverter}}" />
              <Button Content="{Binding Text.CheckForUpdates}"
                      Style="{StaticResource CheckUpdatesButtonStyle}"
                      Command="{Binding CheckNowCommand}"
                      Margin="0,0,12,8" />
              <Button Content="{Binding Text.ForceUpdate}"
                      Style="{StaticResource ForceUpdateButtonStyle}"
                      Command="{Binding ForceRefreshCommand}"
                      Margin="0,0,12,8" />
            </WrapPanel>

            <ComboBox Grid.Column="1"
                      Style="{StaticResource LanguageSelectorComboBoxStyle}"
                      Margin="0,0,0,8"
                      HorizontalAlignment="Right"
                      VerticalAlignment="Top"
                      ItemsSource="{Binding LanguageOptions}"
                      SelectedItem="{Binding SelectedLanguageOption}"
                      DisplayMemberPath="Label" />
          </Grid>
        </Grid>
      </Border>

      <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid>
          <Border Style="{StaticResource PanelBorderStyle}">
            <Grid>
              <Grid.Style>
                <Style TargetType="Grid">
                  <Setter Property="Visibility" Value="Collapsed" />
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding SelectedPage}" Value="Dashboard">
                      <Setter Property="Visibility" Value="Visible" />
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Grid.Style>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="18" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel>
                <Border Style="{StaticResource CardBorderStyle}"
                        Margin="0,0,0,18"
                        Background="{StaticResource WarningSurfaceBrush}"
                        BorderBrush="#5A4727"
                        Visibility="{Binding ShowAppUpdateBanner, Converter={StaticResource BoolToVisibilityConverter}}">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,18,0">
                      <TextBlock Text="{Binding AppUpdateBannerTitle}" Style="{StaticResource SectionTitleTextStyle}" />
                      <TextBlock Text="{Binding AppUpdateBannerText}"
                                 Margin="0,10,0,0"
                                 Style="{StaticResource HelperTextStyle}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                      <Button Content="{Binding UpdateNowLabel}"
                              Style="{StaticResource PrimaryButtonStyle}"
                              Command="{Binding InstallAppUpdateCommand}"
                              MinWidth="132"
                              Margin="0,0,10,10" />
                      <Button Content="{Binding LaterLabel}"
                              Style="{StaticResource CompactActionButtonStyle}"
                              Command="{Binding LaterAppUpdateCommand}"
                              MinWidth="92"
                              Margin="0,0,0,10" />
                    </WrapPanel>
                  </Grid>
                </Border>

                <WrapPanel ItemWidth="236" Margin="0,0,0,4">
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                    <StackPanel>
                      <TextBlock Text="{Binding Text.LastChecked}" Style="{StaticResource FieldLabelTextStyle}" />
                      <TextBlock Text="{Binding LastCheckedText}" Style="{StaticResource ValueTextStyle}" Margin="0,10,0,0" FontSize="17" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                    <StackPanel>
                      <TextBlock Text="{Binding Text.LastUpdated}" Style="{StaticResource FieldLabelTextStyle}" />
                      <TextBlock Text="{Binding LastUpdatedText}" Style="{StaticResource ValueTextStyle}" Margin="0,10,0,0" FontSize="17" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                    <StackPanel>
                      <TextBlock Text="{Binding Text.SelectedAccount}" Style="{StaticResource FieldLabelTextStyle}" />
                      <TextBlock Text="{Binding SelectedAccountText}" Style="{StaticResource ValueTextStyle}" Margin="0,10,0,0" FontSize="17" />
                    </StackPanel>
                  </Border>
                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                    <StackPanel>
                      <TextBlock Text="{Binding Text.NextCheck}" Style="{StaticResource FieldLabelTextStyle}" />
                      <TextBlock Text="{Binding NextCheckText}" Style="{StaticResource ValueTextStyle}" Margin="0,10,0,0" FontSize="17" />
                    </StackPanel>
                  </Border>
                </WrapPanel>
              </StackPanel>

              <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
                <Grid>
                  <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                  </Grid.RowDefinitions>

                  <StackPanel Margin="0,0,8,0">
                    <TextBlock Text="{Binding Text.HeroGrid}" Style="{StaticResource SectionTitleTextStyle}" />
                    <TextBlock Text="{Binding StatusTitle}" Margin="0,12,0,0" FontSize="32" FontWeight="SemiBold" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding StatusText}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" />
                  </StackPanel>

                  <WrapPanel Grid.Row="2" ItemWidth="248" Margin="0,0,0,4">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="232">
                      <StackPanel>
                        <TextBlock Text="{Binding Text.Source}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock Text="{Binding CurrentSourceText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource HelperTextStyle}"
                                   ToolTip="{Binding CurrentSourceText}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="232">
                      <StackPanel>
                        <TextBlock Text="{Binding Text.AvailableHash}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock Text="{Binding AvailableGridHashText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource HashTextStyle}"
                                   ToolTip="{Binding AvailableGridHashText}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="232">
                      <StackPanel>
                        <TextBlock Text="{Binding Text.InstalledHash}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock Text="{Binding InstalledGridHashText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource HashTextStyle}"
                                   ToolTip="{Binding InstalledGridHashText}" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="232">
                      <StackPanel>
                        <TextBlock Text="{Binding Text.SelectedGridPath}" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBlock Text="{Binding SelectedAccountPathText}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource PathTextStyle}"
                                   ToolTip="{Binding SelectedAccountPathText}" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                </Grid>
              </Border>

              <Border Grid.Row="4">
                <Border.Style>
                  <Style TargetType="Border" BasedOn="{StaticResource CardBorderStyle}">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                      <DataTrigger Binding="{Binding HasInitializationWarning}" Value="True">
                        <Setter Property="Visibility" Value="Visible" />
                        <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                        <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </Border.Style>
                <StackPanel>
                  <TextBlock Text="{Binding Text.AttentionRequired}" Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock Text="{Binding InitializationWarning}" Margin="0,10,0,0" Style="{StaticResource HelperTextStyle}" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>

          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage}" Value="HeroGrid">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="Current MetaGrid Grid" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
              <TextBlock Text="MetaGrid maintains one dedicated hero grid from the official Dota2ProTracker High Winrate payload while preserving your own unrelated custom grids."
                         Margin="0,10,0,0"
                         Style="{StaticResource HelperTextStyle}" />

              <WrapPanel Margin="0,22,0,4" ItemWidth="236">
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                  <StackPanel>
                    <TextBlock Text="Source" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding CurrentSourceText}"
                               Margin="0,10,0,0"
                               Style="{StaticResource HelperTextStyle}"
                               ToolTip="{Binding CurrentSourceText}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                  <StackPanel>
                    <TextBlock Text="Hashes" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding BaseGridHashText, StringFormat=Base: {0}}"
                               Margin="0,10,0,0"
                               Style="{StaticResource HashTextStyle}"
                               ToolTip="{Binding BaseGridHashText}" />
                    <TextBlock Text="{Binding AvailableGridHashText, StringFormat=Available: {0}}"
                               Margin="0,8,0,0"
                               Style="{StaticResource HashTextStyle}"
                               ToolTip="{Binding AvailableGridHashText}" />
                    <TextBlock Text="{Binding InstalledGridHashText, StringFormat=Installed: {0}}"
                               Margin="0,8,0,0"
                               Style="{StaticResource HashTextStyle}"
                               ToolTip="{Binding InstalledGridHashText}" />
                    <TextBlock Text="{Binding CachedGridHashText, StringFormat=Cached: {0}}"
                               Margin="0,8,0,0"
                               Style="{StaticResource HashTextStyle}"
                               Foreground="{StaticResource SecondaryBrush}"
                               ToolTip="{Binding CachedGridHashText}" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                  <StackPanel>
                    <TextBlock Text="{Binding HeroCountLabel}" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding HeroCountText}" Margin="0,10,0,0" Style="{StaticResource ValueTextStyle}" FontSize="24" />
                  </StackPanel>
                </Border>
                <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="220">
                  <StackPanel>
                    <TextBlock Text="Criteria" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBlock Text="{Binding GridCriteriaText}" Margin="0,10,0,0" Style="{StaticResource HelperTextStyle}" />
                  </StackPanel>
                </Border>
              </WrapPanel>

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,8,0,0">
                <StackPanel>
                  <TextBlock Text="{Binding CurrentGridPreviewTitle}" Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock Text="{Binding CurrentGridPreviewSubtitle}"
                             Margin="0,8,0,0"
                             Style="{StaticResource HelperTextStyle}" />

                  <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                    <StackPanel>
                      <TextBlock Text="Personalization" Style="{StaticResource SectionTitleTextStyle}" />
                      <TextBlock Text="{Binding PersonalizationStatusText}" Margin="0,10,0,0" Style="{StaticResource ValueTextStyle}" />
                      <TextBlock Text="{Binding PersonalizationConnectedAccountText}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" />
                      <TextBlock Text="{Binding PersonalizationLastRefreshText, StringFormat=Last refresh: {0}}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" />
                      <TextBlock Text="{Binding PersonalizationDetailsText}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" />

                      <ItemsControl ItemsSource="{Binding PersonalHeroPreviewItems}" Margin="0,12,0,0">
                        <ItemsControl.ItemsPanel>
                          <ItemsPanelTemplate>
                            <WrapPanel />
                          </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                          <DataTemplate>
                            <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="180" MaxWidth="220">
                              <StackPanel>
                                <TextBlock Text="{Binding HeroName}" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" />
                                <TextBlock Text="{Binding StatLine}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" />
                              </StackPanel>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                  <ListBox ItemsSource="{Binding GridPreviewLayouts}"
                           SelectedItem="{Binding SelectedGridPreviewLayout}"
                           DisplayMemberPath="DisplayLabel"
                           Margin="0,16,0,8"
                           Style="{StaticResource GridLayoutSelectorListBoxStyle}" />

                  <ItemsControl ItemsSource="{Binding SelectedGridPreviewLayout.Categories}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" MinWidth="250" MaxWidth="320" Padding="16">
                          <StackPanel>
                            <TextBlock Text="{Binding Name}" Style="{StaticResource SectionTitleTextStyle}" FontSize="16" />
                            <TextBlock Text="{Binding HeroCountText}"
                                       Margin="0,8,0,0"
                                       Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding HeroPreviewText}"
                                       Margin="0,10,0,0"
                                       Style="{StaticResource HelperTextStyle}" />
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Text="{Binding TopFivePreviewText}"
                             Margin="0,4,0,0"
                             Visibility="Collapsed" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage}" Value="Accounts">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text.SteamAccounts}" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
                <Button Grid.Column="1"
                        Content="{Binding Text.RedetectSteam}"
                        Style="{StaticResource CompactActionButtonStyle}"
                        Command="{Binding DetectSteamCommand}" />
              </Grid>

              <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" Style="{StaticResource SectionTitleTextStyle}" />
                          <TextBlock Text="{Binding AccountSubtitle}" Margin="0,6,0,0" Style="{StaticResource HelperTextStyle}" />
                          <WrapPanel Margin="0,12,0,0">
                            <Border Style="{StaticResource StatusChipSuccessBorderStyle}">
                              <TextBlock Text="{Binding DotaStatus}" Style="{StaticResource StatusChipTextStyle}" />
                            </Border>
                            <Border>
                              <Border.Style>
                                <Style TargetType="Border" BasedOn="{StaticResource StatusChipBorderStyle}">
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding GridState}" Value="Present">
                                      <Setter Property="Background" Value="{StaticResource SuccessSurfaceBrush}" />
                                      <Setter Property="BorderBrush" Value="#355340" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GridState}" Value="NoManagedGrid">
                                      <Setter Property="Background" Value="{StaticResource WarningSurfaceBrush}" />
                                      <Setter Property="BorderBrush" Value="#5A4727" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding GridState}" Value="MalformedFile">
                                      <Setter Property="Background" Value="{StaticResource DangerSurfaceBrush}" />
                                      <Setter Property="BorderBrush" Value="#5B3538" />
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                              <TextBlock Text="{Binding GridConfigStatus}" Style="{StaticResource StatusChipTextStyle}" />
                            </Border>
                          </WrapPanel>
                          <TextBlock Text="{Binding GridConfigDetail}" Margin="0,4,0,0" Style="{StaticResource MetadataTextStyle}" />
                          <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding DataContext.Text.DetectedMetaGridHash, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding CurrentGridHash}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource HashTextStyle}"
                                       ToolTip="{Binding Model.CurrentMetaGridHash}" />
                          </StackPanel>
                          <StackPanel Margin="0,12,0,0">
                            <TextBlock Text="{Binding DataContext.Text.ConfigPath, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabelTextStyle}" />
                            <TextBlock Text="{Binding ConfigPath}"
                                       Margin="0,6,0,0"
                                       Style="{StaticResource PathTextStyle}"
                                       ToolTip="{Binding ConfigPath}" />
                          </StackPanel>
                        </StackPanel>
                        <RadioButton Grid.Column="1"
                                     GroupName="MetaGridAccounts"
                                     IsChecked="{Binding IsSelected}"
                                     VerticalAlignment="Top"
                                     Margin="16,0,0,0"
                                     Content="{Binding SelectionLabel}" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage}" Value="UpdateHistory">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <Grid Margin="0,0,0,18">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{Binding Text.UpdateHistory}" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
                <Button Grid.Column="1"
                        Content="{Binding Text.ClearHistory}"
                        Style="{StaticResource DestructiveButtonStyle}"
                        Command="{Binding ClearHistoryCommand}" />
              </Grid>

              <ListView ItemsSource="{Binding History}">
                <ListView.ItemTemplate>
                  <DataTemplate>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,10">
                      <Grid>
                        <Grid.RowDefinitions>
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                          <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel>
                          <TextBlock Text="{Binding Operation}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Text="{Binding Timestamp, StringFormat={}{0:g}}"
                                     Margin="0,4,0,0"
                                     Foreground="{StaticResource SecondaryBrush}" />
                        </StackPanel>

                        <TextBlock Grid.Row="1"
                                   Text="{Binding Message}"
                                   Margin="0,10,0,0"
                                   Style="{StaticResource HelperTextStyle}" />

                        <WrapPanel Grid.Row="2" Margin="0,12,0,0">
                          <Border Style="{StaticResource StatusChipBorderStyle}">
                            <TextBlock Text="{Binding Status}" Style="{StaticResource StatusChipTextStyle}" />
                          </Border>
                          <Border Style="{StaticResource StatusChipBorderStyle}">
                            <TextBlock Text="{Binding AccountDisplayName}" Style="{StaticResource StatusChipTextStyle}" />
                          </Border>
                          <Border Style="{StaticResource StatusChipBorderStyle}">
                            <TextBlock Text="{Binding Source}" Style="{StaticResource StatusChipTextStyle}" />
                          </Border>
                        </WrapPanel>

                        <Grid Grid.Row="3" Margin="0,12,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                          </Grid.RowDefinitions>

                          <TextBlock Text="{Binding DataContext.Text.PreviousHash, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,12,0" />
                          <TextBlock Grid.Column="1"
                                     Text="{Binding PreviousHash}"
                                     Style="{StaticResource HashTextStyle}"
                                     MaxWidth="320"
                                     ToolTip="{Binding PreviousHash}" />

                          <TextBlock Grid.Row="1" Text="{Binding DataContext.Text.NewHash, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,12,0" />
                          <TextBlock Grid.Row="1"
                                     Grid.Column="1"
                                     Text="{Binding NewHash}"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource HashTextStyle}"
                                     MaxWidth="320"
                                     ToolTip="{Binding NewHash}" />

                          <TextBlock Grid.Row="2" Text="{Binding DataContext.Text.ChangedHeroes, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource FieldLabelTextStyle}" Margin="0,8,12,0" />
                          <TextBlock Grid.Row="2"
                                     Grid.Column="1"
                                     Text="{Binding ChangedHeroCount}"
                                     Margin="0,8,0,0"
                                     Style="{StaticResource HelperTextStyle}" />
                        </Grid>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ListView.ItemTemplate>
              </ListView>
            </StackPanel>
          </Border>

          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage}" Value="Settings">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="Settings" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
              <TextBlock Text="MetaGrid keeps settings explicit: change values here, then save them as one consistent update."
                         Margin="0,10,0,0"
                         Style="{StaticResource HelperTextStyle}" />

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,22,0,0">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                  <TextBlock Text="General" Style="{StaticResource SectionTitleTextStyle}" />
                  <CheckBox Content="Launch with Windows" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.LaunchWithWindows}" />
                  <CheckBox Content="Start minimized" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.StartMinimized}" />
                  <CheckBox Content="Minimize to tray" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.MinimizeToTray}" />
                  <CheckBox Content="Close button minimizes to tray" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.CloseToTray}" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                  <TextBlock Text="Updates" Style="{StaticResource SectionTitleTextStyle}" />
                  <CheckBox Content="Automatic updates" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.AutoUpdateEnabled}" />
                  <TextBlock Text="Automatically check, download, validate, and install new official Dota2ProTracker High Winrate hero-grid updates."
                             Style="{StaticResource HelperTextStyle}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                  <CheckBox Content="Check for MetaGrid app updates automatically"
                            Style="{StaticResource SettingsToggleRowStyle}"
                            IsChecked="{Binding EditableSettings.AutomaticallyCheckAppUpdates}" />
                  <TextBlock Text="This controls GitHub Releases checks for newer MetaGrid builds and stays separate from Dota hero-grid update scheduling."
                             Style="{StaticResource HelperTextStyle}"
                             Margin="0,4,0,0"
                             TextWrapping="Wrap" />
                  <WrapPanel Margin="0,6,0,0">
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,12,12" Padding="16" Width="320" IsEnabled="{Binding EditableSettings.AutoUpdateEnabled}">
                      <StackPanel>
                        <TextBlock Text="Update Interval" Style="{StaticResource FieldLabelTextStyle}" />
                        <ComboBox ItemsSource="{Binding UpdateIntervalOptions}"
                                  SelectedValuePath="Value"
                                  DisplayMemberPath="Label"
                                  SelectedValue="{Binding EditableSettings.UpdateInterval}"
                                  Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                    <Border Style="{StaticResource CardBorderStyle}" Margin="0,0,0,12" Padding="16" Width="220">
                      <StackPanel>
                        <TextBlock Text="Backup Retention" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding EditableSettings.BackupRetentionCount, UpdateSourceTrigger=PropertyChanged}" Margin="0,8,0,0" />
                      </StackPanel>
                    </Border>
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                  <TextBlock Text="Steam and Advanced" Style="{StaticResource SectionTitleTextStyle}" />
                  <CheckBox Content="Automatically detect Steam" Style="{StaticResource SettingsToggleRowStyle}" IsChecked="{Binding EditableSettings.AutomaticallyDetectSteam}" />
                  <TextBlock Text="Manual Steam Directory Override" Style="{StaticResource FieldLabelTextStyle}" />
                  <TextBox Text="{Binding EditableSettings.SteamDirectoryOverride, UpdateSourceTrigger=PropertyChanged}"
                           Margin="0,8,0,0"
                           ToolTip="{Binding EditableSettings.SteamDirectoryOverride}" />

                  <WrapPanel Margin="0,18,0,0">
                    <Button Content="Open Config Directory"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding OpenConfigCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Open Backups Folder"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding OpenBackupsCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Open Logs Folder"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding OpenLogsCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Restore Backup"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Click="RestoreBackupClick"
                            Margin="0,0,10,10" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch">
                  <TextBlock Text="Personal Hero Recommendations" Style="{StaticResource SectionTitleTextStyle}" />
                  <CheckBox Content="Enable personal hero row"
                            Style="{StaticResource SettingsToggleRowStyle}"
                            IsChecked="{Binding EditableSettings.PersonalizationEnabled}" />
                  <TextBlock Text="Player Source" Style="{StaticResource FieldLabelTextStyle}" />
                  <ComboBox ItemsSource="{Binding PersonalizationSourceOptions}"
                            SelectedValuePath="Value"
                            DisplayMemberPath="Label"
                            SelectedValue="{Binding EditableSettings.PersonalizationAccountSourceMode}"
                            Margin="0,8,0,0"
                            MinWidth="280"
                            MaxWidth="340"
                            HorizontalAlignment="Left" />
                  <TextBlock Text="{Binding PersonalizationSourceText}"
                             Margin="0,10,0,0"
                             Style="{StaticResource ValueTextStyle}" />
                  <TextBlock Text="{Binding PersonalizationConnectedAccountText}"
                             Margin="0,8,0,0"
                             Style="{StaticResource HelperTextStyle}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="OpenDota automatically uses your selected Steam account when Selected Steam account mode is active."
                             Margin="0,8,0,0"
                             Style="{StaticResource HelperTextStyle}"
                             TextWrapping="Wrap" />

                  <Border Margin="0,16,0,0">
                    <Border.Style>
                      <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding EditableSettings.PersonalizationAccountSourceMode}" Value="ManualAccount">
                            <Setter Property="Visibility" Value="Visible" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Border.Style>
                    <StackPanel>
                      <TextBlock Text="Advanced / Manual Override" Style="{StaticResource FieldLabelTextStyle}" />
                      <TextBox Text="{Binding PersonalizationInput, UpdateSourceTrigger=PropertyChanged}"
                               Margin="0,8,0,0"
                               ToolTip="OpenDota URL, Dotabuff player URL, or numeric account ID" />
                      <TextBlock Text="Dotabuff URLs are accepted only to extract the numeric player ID. MetaGrid does not scrape Dotabuff stats or require a login."
                                 Margin="0,8,0,0"
                                 Style="{StaticResource HelperTextStyle}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>

                  <WrapPanel Margin="0,16,0,0">
                    <Button Content="Connect"
                            Command="{Binding ConnectPersonalizationCommand}"
                            MinWidth="128"
                            Margin="0,0,10,10">
                      <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButtonStyle}">
                          <Setter Property="Visibility" Value="Collapsed" />
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding EditableSettings.PersonalizationAccountSourceMode}" Value="ManualAccount">
                              <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Button.Style>
                    </Button>
                    <Button Content="Refresh Personal Heroes"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding RefreshPersonalHeroesCommand}"
                            Margin="0,0,10,10" />
                    <Button Content="Disconnect"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding DisconnectPersonalizationCommand}"
                            Margin="0,0,0,10" />
                  </WrapPanel>

                  <TextBlock Text="{Binding PersonalizationStatusText}" Margin="0,8,0,0" Style="{StaticResource ValueTextStyle}" />
                  <TextBlock Text="{Binding PersonalizationLastRefreshText, StringFormat=Last personal stats refresh: {0}}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" />
                  <TextBlock Text="{Binding PersonalizationDetailsText}" Margin="0,8,0,0" Style="{StaticResource HelperTextStyle}" TextWrapping="Wrap" />
                  <TextBlock Text="Rules: last 90 days, at least 10 matches, at least 53% win rate, maximum 7 heroes."
                             Margin="0,12,0,0"
                             Style="{StaticResource HelperTextStyle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Border>

              <Border Style="{StaticResource CardBorderStyle}" Margin="0,16,0,0">
                <Grid MaxWidth="1080" HorizontalAlignment="Stretch">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                  </Grid.ColumnDefinitions>

                  <StackPanel VerticalAlignment="Center" Margin="0,0,18,0">
                    <TextBlock Text="Save Settings" Style="{StaticResource SectionTitleTextStyle}" FontSize="18" />
                    <TextBlock Text="{Binding SettingsSaveStateText}"
                               Margin="0,8,0,0"
                               Style="{StaticResource HelperTextStyle}" />
                  </StackPanel>

                  <Button Grid.Column="1"
                          Content="Save Settings"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding SaveSettingsCommand}"
                          MinWidth="148"
                          Margin="0,0,0,0"
                          VerticalAlignment="Center" />
                </Grid>
              </Border>
            </StackPanel>
          </Border>

          <Border>
            <Border.Style>
              <Style TargetType="Border" BasedOn="{StaticResource PanelBorderStyle}">
                <Setter Property="Visibility" Value="Collapsed" />
                <Style.Triggers>
                  <DataTrigger Binding="{Binding SelectedPage}" Value="About">
                    <Setter Property="Visibility" Value="Visible" />
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <StackPanel>
              <TextBlock Text="About MetaGrid" Style="{StaticResource PageTitleTextStyle}" FontSize="28" />
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="Application Updates" Style="{StaticResource SectionTitleTextStyle}" />
                  <WrapPanel Margin="0,16,0,10">
                    <Border Style="{StaticResource StatusChipBorderStyle}">
                      <TextBlock Text="{Binding AppUpdateChipText}" Style="{StaticResource StatusChipTextStyle}" />
                    </Border>
                    <Border Style="{StaticResource StatusChipSuccessBorderStyle}">
                      <TextBlock Text="{Binding CurrentAppVersionText, StringFormat=Current {0}}" Style="{StaticResource StatusChipTextStyle}" />
                    </Border>
                    <Border Style="{StaticResource StatusChipBorderStyle}">
                      <TextBlock Text="{Binding AppUpdateAvailableVersionText, StringFormat=Latest {0}}" Style="{StaticResource StatusChipTextStyle}" />
                    </Border>
                  </WrapPanel>
                  <TextBlock Text="{Binding AppUpdateStatusTitle}" Style="{StaticResource ValueTextStyle}" FontSize="24" />
                  <TextBlock Text="{Binding AppUpdateStatusText}"
                             Margin="0,10,0,0"
                             Style="{StaticResource HelperTextStyle}"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding AppUpdateLastCheckedText, StringFormat=Last checked: {0}}"
                             Margin="0,12,0,0"
                             Style="{StaticResource HelperTextStyle}" />
                  <WrapPanel Margin="0,18,0,0">
                    <Button Content="{Binding CheckAppUpdatesLabel}"
                            Style="{StaticResource PrimaryButtonStyle}"
                            Command="{Binding CheckAppUpdatesCommand}"
                            MinWidth="180"
                            Margin="0,0,12,12" />
                    <Button Content="{Binding UpdateNowLabel}"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding InstallAppUpdateCommand}"
                            Visibility="{Binding HasAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            MinWidth="132"
                            Margin="0,0,12,12" />
                    <Button Content="{Binding LaterLabel}"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding LaterAppUpdateCommand}"
                            Visibility="{Binding HasAppUpdateAvailable, Converter={StaticResource BoolToVisibilityConverter}}"
                            MinWidth="92"
                            Margin="0,0,0,12" />
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource CardBorderStyle}" Margin="0,18,0,0">
                <StackPanel>
                  <TextBlock Text="MetaGrid is an independent Windows utility for keeping a Dota 2 hero grid synchronized with current public match statistics while preserving user-managed grids."
                             Style="{StaticResource HelperTextStyle}" />
                  <TextBlock Text="This beta focuses on reliable startup, safe configuration updates, account-aware backups, and a premium dark desktop experience."
                             Margin="0,12,0,0"
                             Style="{StaticResource HelperTextStyle}" />
                  <TextBlock Text="Made by Darvel &amp; Codex"
                             Margin="0,18,0,0"
                             Style="{StaticResource SectionTitleTextStyle}" />
                  <TextBlock Text="MetaGrid is not affiliated with Valve Corporation."
                             Margin="0,10,0,0"
                             Style="{StaticResource MetadataTextStyle}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>
        </Grid>
      </ScrollViewer>
    </Grid>

    <Border Grid.ColumnSpan="3"
            Background="#D9141414"
            Visibility="{Binding OnboardingVisible, Converter={StaticResource BoolToVisibilityConverter}}">
      <Grid>
        <Border HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MinWidth="500"
                MaxWidth="560"
                Margin="40"
                Style="{StaticResource PanelBorderStyle}">
          <ScrollViewer VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled"
                        MaxHeight="620">
            <Grid MinWidth="460">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="24" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="28" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <StackPanel HorizontalAlignment="Center">
                <TextBlock Text="{Binding OnboardingTitle}"
                           Style="{StaticResource PageTitleTextStyle}"
                           FontSize="34"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <TextBlock Text="{Binding OnboardingDescription}"
                           Margin="0,14,0,0"
                           MaxWidth="420"
                           Foreground="{StaticResource SecondaryBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center" />
                <WrapPanel Margin="0,24,0,0" HorizontalAlignment="Center">
                  <Border Style="{StaticResource StatusChipBorderStyle}">
                    <TextBlock Text="{Binding OnboardingStepLabel}" Style="{StaticResource StatusChipTextStyle}" />
                  </Border>
                  <Border Style="{StaticResource StatusChipBorderStyle}">
                    <TextBlock Text="{Binding AutoUpdateChipText}" Style="{StaticResource StatusChipTextStyle}" />
                  </Border>
                </WrapPanel>
              </StackPanel>

              <Grid Grid.Row="2">
                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOnboardingWelcomeStep, Converter={StaticResource BoolToVisibilityConverter}}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="MetaGrid keeps one dedicated hero grid current from the official Dota2ProTracker High Winrate payload while preserving your own custom Dota layouts."
                               Style="{StaticResource SectionTitleTextStyle}"
                               MaxWidth="400"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="The first run stays window-first and visible. Steam detection, account selection, automatic checks and backups are layered in after the shell appears."
                               Margin="0,14,0,0"
                               MaxWidth="400"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOnboardingSteamStep, Converter={StaticResource BoolToVisibilityConverter}}">
                  <StackPanel>
                    <TextBlock Text="{Binding SteamDetectionStatusText}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               TextWrapping="Wrap" />
                    <TextBlock Text="{Binding SteamDetectionPathText}"
                               Margin="0,12,0,16"
                               MaxWidth="400"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <CheckBox Content="{Binding Text.AutomaticDetectSteam}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,16" IsChecked="{Binding Settings.AutomaticallyDetectSteam}" />
                    <TextBlock Text="{Binding Text.ManualSteamDirectory}" Style="{StaticResource FieldLabelTextStyle}" />
                    <TextBox Text="{Binding Settings.SteamDirectoryOverride}" Margin="0,8,0,0" />
                    <Button Content="{Binding Text.DetectSteamAgain}"
                            Style="{StaticResource CompactActionButtonStyle}"
                            Command="{Binding DetectSteamCommand}"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOnboardingAccountsStep, Converter={StaticResource BoolToVisibilityConverter}}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding OnboardingSelectedAccountLabel}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               MaxWidth="400"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding SelectedAccountPathText}"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Left"
                               Width="400" />
                    <TextBlock Text="{Binding OnboardingAccountsHintText}"
                               Margin="0,14,0,0"
                               MaxWidth="400"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOnboardingAutoUpdateStep, Converter={StaticResource BoolToVisibilityConverter}}">
                  <StackPanel>
                    <CheckBox Content="{Binding Text.EnableAutomaticUpdates}" Style="{StaticResource ToggleSwitchStyle}" Margin="0,0,0,16" IsChecked="{Binding Settings.AutoUpdateEnabled}" />
                    <TextBlock Text="{Binding OnboardingAutoUpdateHelpText}"
                               Style="{StaticResource HelperTextStyle}"
                               Margin="0,0,0,12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center"
                               MaxWidth="420" />
                    <TextBlock Text="{Binding Text.UpdateInterval}" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox MinWidth="220"
                              MaxWidth="280"
                              ItemsSource="{Binding UpdateIntervalOptions}"
                              SelectedValuePath="Value"
                              DisplayMemberPath="Label"
                              SelectedValue="{Binding Settings.UpdateInterval}"
                              Margin="0,8,0,0"
                              HorizontalAlignment="Left" />
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}" Visibility="{Binding IsOnboardingReadyStep, Converter={StaticResource BoolToVisibilityConverter}}">
                  <StackPanel HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Text.SetupSummary}"
                               Style="{StaticResource SectionTitleTextStyle}"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding OnboardingSummaryText}"
                               Margin="0,12,0,0"
                               MaxWidth="400"
                               Foreground="{StaticResource SecondaryBrush}"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               HorizontalAlignment="Center" />
                  </StackPanel>
                </Border>
              </Grid>

              <Grid Grid.Row="4" HorizontalAlignment="Center">
                <WrapPanel HorizontalAlignment="Center">
                  <Button Content="{Binding OnboardingPrimaryLabel}"
                          Style="{StaticResource PrimaryButtonStyle}"
                          Command="{Binding NextOnboardingCommand}"
                          MinWidth="136"
                          Margin="0,0,12,12" />
                  <Button Content="{Binding Text.FinishSetup}"
                          Command="{Binding FinishOnboardingCommand}"
                          Visibility="{Binding ShowFinishOnboardingButton, Converter={StaticResource BoolToVisibilityConverter}}"
                          MinWidth="136"
                          Margin="0,0,0,12" />
                </WrapPanel>
              </Grid>
            </Grid>
          </ScrollViewer>
        </Border>
      </Grid>
    </Border>
  </Grid>
</Window>
