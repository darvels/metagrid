<Window x:Class="MetaGrid.UI.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Confirm Restore"
        Width="520"
        Style="{StaticResource DialogWindowStyle}">
  <Border Style="{StaticResource PanelBorderStyle}" Margin="18">
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="18" />
        <RowDefinition Height="Auto" />
        <RowDefinition Height="24" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>

      <StackPanel>
        <TextBlock Text="Restore Selected Backup?" Style="{StaticResource PageTitleTextStyle}" FontSize="24" />
        <TextBlock x:Name="MessageTextBlock" Margin="0,10,0,0" Foreground="{StaticResource SecondaryBrush}" TextWrapping="Wrap" />
      </StackPanel>

      <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
        <StackPanel>
          <TextBlock x:Name="DetailsTextBlock" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0" />
        <Button Content="Restore Backup" Style="{StaticResource PrimaryButtonStyle}" Click="ConfirmClick" />
      </StackPanel>
    </Grid>
  </Border>
</Window>
